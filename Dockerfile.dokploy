# syntax=docker/dockerfile:1

FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS deps
WORKDIR /app
RUN --mount=type=bind,source=package.json,target=/tmp/package.json \
  mkdir /opt/pnpm && cd /opt/pnpm \
  && echo '{"private":true,"allowScripts":{"pnpm":true}}' > package.json \
  && npm install --strict-allow-scripts --no-audit --no-fund --no-update-notifier \
    "$(node -p "require('/tmp/package.json').packageManager")" \
  && npm audit signatures
ENV PATH=/opt/pnpm/node_modules/.bin:$PATH
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS build
WORKDIR /app
RUN --mount=type=bind,source=package.json,target=/tmp/package.json \
  mkdir /opt/pnpm && cd /opt/pnpm \
  && echo '{"private":true,"allowScripts":{"pnpm":true}}' > package.json \
  && npm install --strict-allow-scripts --no-audit --no-fund --no-update-notifier \
    "$(node -p "require('/tmp/package.json').packageManager")" \
  && npm audit signatures
ENV PATH=/opt/pnpm/node_modules/.bin:$PATH
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=6239
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER app
EXPOSE 6239
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:6239/api/health || exit 1
CMD ["node", "server.js"]
